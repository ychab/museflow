##############################################################
# .env — personal overrides and secrets
#
# Copy this file to .env and fill in your values.
# Non-secret defaults live in .envrc (loaded automatically
# by direnv). Only put secrets and personal overrides here.
##############################################################


#########################################
# Secrets (required)
#########################################

# Spotify API credentials (from developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=<your-spotify-client-id>
SPOTIFY_CLIENT_SECRET=<your-spotify-client-secret>

# OpenRouter API key (from openrouter.ai/settings/keys)
OPENROUTER_API_KEY=<your-openrouter-api-key>

# App secret key — min 32 characters, generate with: openssl rand -hex 32
MUSEFLOW_SECRET_KEY=<min-32-character-secret-key>


#########################################
# Personal overrides (optional)
#########################################

# Override the database port if you use a non-standard one:
# DATABASE_PORT=5433

# Override database password if different from the Docker default:
# DATABASE_PASSWORD=mypassword

# Seconds a transaction may stay idle before PostgreSQL ends the session (default 60).
# Set 0 to disable it, e.g. to debug with a breakpoint inside a unit of work block:
# DATABASE_IDLE_IN_TRANSACTION_TIMEOUT=0

# OpenRouter per-step tuning (defaults are set in the app). Steps: ADVISOR, ENRICHER, PROFILER_SEGMENT,
# PROFILER_MERGE, PROFILER_REFLECT. Model ids as listed on openrouter.ai/models; the model must support structured
# outputs and, with OPENROUTER_ZDR on, have a Zero Data Retention endpoint (checked before the first call). Override
# one field and the step keeps its other defaults.
# The lines below are examples, not the defaults: each one changes the cost or the behaviour. Uncomment a line only
# to change that setting.
# OPENROUTER_ENRICHER__MODEL=google/gemini-3.5-flash-lite
# OPENROUTER_ADVISOR__REASONING_EFFORT=high  # none, minimal, low, medium, high, xhigh, max
# OPENROUTER_PROFILER_REFLECT__MAX_TOKENS=16000  # reasoning tokens count against it
# OPENROUTER_PROFILER_MERGE__TEMPERATURE=0.2
# OPENROUTER_ADVISOR__FALLBACK_MODELS=["anthropic/claude-sonnet-4.5"]  # tried in order if the main model fails
# OPENROUTER_ZDR=true  # only route to Zero Data Retention endpoints (narrows the models available)
# OPENROUTER_VALIDATION_MAX_RETRIES=2  # extra attempts when the model returns an invalid structured response
