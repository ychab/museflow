{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/chat/completions",
    "headers": {
      "Authorization": { "equalTo": "Bearer dummy-api-key" }
    },
    "bodyPatterns": [
      { "matchesJsonPath": "$.messages[?(@.content == 'Integration test of the OpenRouter client')]" }
    ]
  },
  "response": {
    "status": 200,
    "bodyFileName": "chat_completions_client.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
